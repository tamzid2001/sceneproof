{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index?ep=home"
    },
    {
      "source": "/brand.png",
      "destination": "/api/index?ep=brand"
    },
    {
      "source": "/favicon-32.png",
      "destination": "/api/index?ep=favicon"
    },
    {
      "source": "/app.css",
      "destination": "/api/index?ep=css"
    },
    {
      "source": "/ui-audit.js",
      "destination": "/api/index?ep=uiaudit"
    },
    {
      "source": "/app.js",
      "destination": "/api/index?ep=js"
    },
    {
      "source": "/api/health",
      "destination": "/api/index?ep=health"
    },
    {
      "source": "/api/scene",
      "destination": "/api/index?ep=scene"
    },
    {
      "source": "/api/run",
      "destination": "/api/index?ep=run"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "src/sceneproof/**"
    }
  }
}
